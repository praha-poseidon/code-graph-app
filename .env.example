CODEGRAPH_DATABASE_URL=jdbc:h2:file:./data/codegraph;MODE=MySQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
CODEGRAPH_DATABASE_USERNAME=sa
CODEGRAPH_DATABASE_PASSWORD=
CODEGRAPH_STORAGE_TYPE=memory
CODEGRAPH_MASTER_KEY=replace-with-a-long-random-secret
CODEGRAPH_MCP_ENABLED=true
CODEGRAPH_MCP_PUBLIC_URL=
CODEGRAPH_MCP_TOKEN=
CODEGRAPH_TASKS_ENABLED=true
CODEGRAPH_WORKSPACE_ROOT=./data/workspaces

# Apache AGE/PostgreSQL deployments:
# CODEGRAPH_STORAGE_TYPE=apache-age
# CODEGRAPH_DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
# CODEGRAPH_DATABASE_USERNAME=postgres
# CODEGRAPH_DATABASE_PASSWORD=replace-me
# CODEGRAPH_DATABASE_DRIVER=org.postgresql.Driver
# CODEGRAPH_DATABASE_SCHEMA=classpath:db/schema-postgresql.sql
